<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="screen-root" stylesheets="@stage-manager.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.ComicController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="module-header">
                <children>
                    <Label style="-fx-font-weight: bold;" text="%comic.panel.title" textFill="WHITE">
                        <font><Font size="20" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="%comic.description" textFill="WHITE" />
                </children>
            </HBox>

            <GridPane hgap="12" styleClass="surface" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="17" />
                    <ColumnConstraints percentWidth="18" />
                </columnConstraints>
                <children>
                    <Label text="%comic.id" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="idField" editable="false" promptText="— select a row —" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="%comic.title" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="titleField" promptText="The Crimson Horizon" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="%comic.issue" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="issueField" promptText="#12" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="%comic.publisher" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="publisherField" promptText="Image Comics" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <Label text="%comic.price" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                    <TextField fx:id="priceField" promptText="19.99" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <GridPane hgap="12" styleClass="surface" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="75" />
                </columnConstraints>
                <children>
                    <Label text="%comic.stock" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="stockField" promptText="0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <GridPane hgap="10" styleClass="surface" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="13" />
                    <ColumnConstraints percentWidth="23" />
                    <ColumnConstraints percentWidth="16" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="8" />
                    <ColumnConstraints percentWidth="10" />
                    <ColumnConstraints percentWidth="10" />
                </columnConstraints>
                <children>
                    <TextField fx:id="searchIdField" promptText="%comic.id" GridPane.columnIndex="0" />
                    <TextField fx:id="searchTitleField" promptText="%comic.title" GridPane.columnIndex="1" />
                    <TextField fx:id="searchIssueField" promptText="%comic.issue" GridPane.columnIndex="2" />
                    <TextField fx:id="searchPublisherField" promptText="%comic.publisher" GridPane.columnIndex="3" />
                    <Button fx:id="searchButton" maxWidth="Infinity" styleClass="primary-button" text="%comic.search.button" GridPane.columnIndex="4" />
                    <Button fx:id="showAllButton" maxWidth="Infinity" styleClass="quiet-button" text="%common.show.all" GridPane.columnIndex="5" />
                    <Button fx:id="clearButton" maxWidth="Infinity" styleClass="quiet-button" text="%comic.clear.button" GridPane.columnIndex="6" />
                </children>
            </GridPane>

            <TableView fx:id="comicTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="60" text="%comic.table.id" />
                    <TableColumn fx:id="titleColumn" prefWidth="220" text="%comic.table.title" />
                    <TableColumn fx:id="issueColumn" prefWidth="90" text="%comic.table.issue" />
                    <TableColumn fx:id="publisherColumn" prefWidth="140" text="%comic.table.publisher" />
                    <TableColumn fx:id="priceColumn" prefWidth="80" text="%comic.table.price" />
                    <TableColumn fx:id="stockColumn" prefWidth="70" text="%comic.table.stock" />
                </columns>
            </TableView>

            <HBox spacing="15">
                <VBox spacing="6" styleClass="metric-tile">
                    <children>
                        <Label text="%comic.comics.in.table" />
                        <Label fx:id="totalComicsLabel" style="-fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10">
                    <Button fx:id="addButton" styleClass="primary-button" text="%comic.new.comic" />
                    <Button fx:id="updateButton" styleClass="quiet-button" text="%comic.save.changes" />
                    <Button fx:id="deleteButton" styleClass="danger-button" text="%comic.remove" />
                    <Button fx:id="refreshButton" styleClass="quiet-button" text="%comic.refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
