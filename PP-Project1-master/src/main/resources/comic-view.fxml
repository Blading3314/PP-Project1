<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #681111);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.ComicController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-background-radius: 14; -fx-padding: 15;">
                <children>
                    <Label style="-fx-font-weight: bold;" text="%comic.title" textFill="WHITE">
                        <font><Font size="20" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="%comic.description" textFill="WHITE" />
                </children>
            </HBox>

            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="17" />
                    <ColumnConstraints percentWidth="18" />
                </columnConstraints>
                <children>
                    <Label text="%comic.id" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="idField" editable="false" promptText="— select a row —" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="%comic.title" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="titleField" promptText="The Crimson Horizon" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="%comic.issue" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="issueField" promptText="#12" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="%comic.publisher" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="publisherField" promptText="Image Comics" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <Label text="%comic.price" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                    <TextField fx:id="priceField" promptText="19.99" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="75" />
                </columnConstraints>
                <children>
                    <Label text="%comic.stock" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="stockField" promptText="0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 12;">
                <children>
                    <TextField fx:id="searchField" promptText="%comic.search.prompt" style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-border-color: #832216; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="searchButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="%comic.search.button" />
                    <Button fx:id="clearButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="%comic.clear.button" />
                </children>
            </HBox>

            <TableView fx:id="comicTable" style="-fx-background-radius: 12; -fx-border-color: #832216; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="60" text="%comic.table.id" />
                    <TableColumn fx:id="titleColumn" prefWidth="220" text="%comic.table.title" />
                    <TableColumn fx:id="issueColumn" prefWidth="90" text="%comic.table.issue" />
                    <TableColumn fx:id="publisherColumn" prefWidth="140" text="%comic.table.publisher" />
                    <TableColumn fx:id="priceColumn" prefWidth="80" text="%comic.table.price" />
                    <TableColumn fx:id="stockColumn" prefWidth="70" text="%comic.table.stock" />
                </columns>
            </TableView>

            <HBox spacing="15">
                <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10;">
                    <children>
                        <Label text="%comic.comics.in.table" />
                        <Label fx:id="totalComicsLabel" style="-fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10">
                    <Button fx:id="addButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="%comic.new.comic" />
                    <Button fx:id="updateButton" style="-fx-background-color: #832216; -fx-text-fill: white; -fx-background-radius: 10;" text="%comic.save.changes" />
                    <Button fx:id="deleteButton" style="-fx-background-color: #681111; -fx-text-fill: white; -fx-background-radius: 10;" text="%comic.remove" />
                    <Button fx:id="refreshButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="%comic.refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
