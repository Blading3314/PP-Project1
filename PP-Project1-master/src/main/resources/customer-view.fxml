<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #681111);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.CustomerController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-background-radius: 14; -fx-padding: 15;">

                <children>
                    <Label style="-fx-font-weight: bold;" text="%customer.title" textFill="WHITE">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="%customer.description" textFill="WHITE" />
                </children>
            </HBox>

            <!-- FORM ROW -->
            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                </columnConstraints>

                <children>
                    <Label text="%customer.id" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="idField" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="%customer.name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="%customer.email" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="emailField" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="%customer.phone" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="phoneField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- SEARCH BAR -->
            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 12;">

                <children>
                    <TextField fx:id="searchField" promptText="%customer.search.prompt" style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-border-color: #832216; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" />

                    <Button fx:id="searchButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="%customer.search.button" />

                    <Button fx:id="clearButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="%customer.clear.button" />
                </children>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="customerTable" style="-fx-background-radius: 12; -fx-border-color: #832216; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="%customer.table.id" />
                    <TableColumn fx:id="nameColumn" prefWidth="200" text="%customer.table.name" />
                    <TableColumn fx:id="emailColumn" prefWidth="250" text="%customer.table.email" />
                    <TableColumn fx:id="phoneColumn" prefWidth="150" text="%customer.table.phone" />
                </columns>
            </TableView>

            <!-- SUMMARY + ACTIONS -->
            <HBox spacing="15">

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="10">

                    <Button fx:id="addButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="%customer.new.customer" />

                    <Button fx:id="updateButton" style="-fx-background-color: #832216; -fx-text-fill: white; -fx-background-radius: 10;" text="%customer.save.changes" />

                    <Button fx:id="deleteButton" style="-fx-background-color: #681111; -fx-text-fill: white; -fx-background-radius: 10;" text="%customer.remove" />

                    <Button fx:id="refreshButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="%customer.refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
