<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="screen-root" stylesheets="@stage-manager.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.CustomerController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="module-header">

                <children>
                    <Label style="-fx-font-weight: bold;" text="%customer.title" textFill="WHITE">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="%customer.description" textFill="WHITE" />
                </children>
            </HBox>

            <!-- FORM ROW -->
            <GridPane hgap="12" styleClass="surface" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                </columnConstraints>

                <children>
                    <Label text="%customer.id" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="idField" editable="false" promptText="new" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="%customer.name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="%customer.email" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="emailField" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="%customer.phone" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="phoneField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- SEARCH BAR -->
            <GridPane hgap="10" styleClass="surface" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="12" />
                    <ColumnConstraints percentWidth="22" />
                    <ColumnConstraints percentWidth="22" />
                    <ColumnConstraints percentWidth="16" />
                    <ColumnConstraints percentWidth="8" />
                    <ColumnConstraints percentWidth="10" />
                    <ColumnConstraints percentWidth="10" />
                </columnConstraints>
                <children>
                    <TextField fx:id="searchIdField" promptText="%customer.id" GridPane.columnIndex="0" />
                    <TextField fx:id="searchNameField" promptText="%customer.name" GridPane.columnIndex="1" />
                    <TextField fx:id="searchEmailField" promptText="%customer.email" GridPane.columnIndex="2" />
                    <TextField fx:id="searchPhoneField" promptText="%customer.phone" GridPane.columnIndex="3" />
                    <Button fx:id="searchButton" maxWidth="Infinity" styleClass="primary-button" text="%customer.search.button" GridPane.columnIndex="4" />
                    <Button fx:id="showAllButton" maxWidth="Infinity" styleClass="quiet-button" text="%common.show.all" GridPane.columnIndex="5" />
                    <Button fx:id="clearButton" maxWidth="Infinity" styleClass="quiet-button" text="%customer.clear.button" GridPane.columnIndex="6" />
                </children>
            </GridPane>

            <!-- TABLE -->
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="%customer.table.id" />
                    <TableColumn fx:id="nameColumn" prefWidth="200" text="%customer.table.name" />
                    <TableColumn fx:id="emailColumn" prefWidth="250" text="%customer.table.email" />
                    <TableColumn fx:id="phoneColumn" prefWidth="150" text="%customer.table.phone" />
                </columns>
            </TableView>

            <!-- SUMMARY + ACTIONS -->
            <HBox spacing="15">

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="10">

                    <Button fx:id="addButton" styleClass="primary-button" text="%customer.new.customer" />

                    <Button fx:id="updateButton" styleClass="quiet-button" text="%customer.save.changes" />

                    <Button fx:id="deleteButton" styleClass="danger-button" text="%customer.remove" />

                    <Button fx:id="refreshButton" styleClass="quiet-button" text="%customer.refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
