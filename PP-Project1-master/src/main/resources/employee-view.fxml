<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #681111);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.EmployeeController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-background-radius: 14; -fx-padding: 15;">
                <children>
                    <Label style="-fx-font-weight: bold;" text="Employee roster" textFill="WHITE">
                        <font><Font size="20" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Add people, keep contact info current" textFill="WHITE" />
                </children>
            </HBox>

            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="30" />
                </columnConstraints>
                <children>
                    <Label text="Employee ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="idField" editable="false" promptText="— select a row —" style="-fx-opacity: 0.95;" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="First name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="firstNameField" promptText="Jordan" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Last name" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="lastNameField" promptText="Hayes" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="Phone" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="phoneField" promptText="555-0100" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="6">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="100" />
                </columnConstraints>
                <children>
                    <Label text="Work email" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="emailField" promptText="name@store.example" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 12;">
                <children>
                    <TextField fx:id="searchField" promptText="Search by name, email, phone, or ID…" style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-border-color: #832216; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="searchButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="Search" />
                    <Button fx:id="clearButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Clear" />
                </children>
            </HBox>

            <TableView fx:id="employeeTable" style="-fx-background-radius: 12; -fx-border-color: #832216; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="70" text="ID" />
                    <TableColumn fx:id="fnameColumn" prefWidth="140" text="First" />
                    <TableColumn fx:id="lnameColumn" prefWidth="140" text="Last" />
                    <TableColumn fx:id="phoneColumn" prefWidth="130" text="Phone" />
                    <TableColumn fx:id="emailColumn" prefWidth="260" text="Email" />
                </columns>
            </TableView>

            <HBox spacing="15">
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10">
                    <Button fx:id="addButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="Add employee" />
                    <Button fx:id="updateButton" style="-fx-background-color: #832216; -fx-text-fill: white; -fx-background-radius: 10;" text="Save changes" />
                    <Button fx:id="deleteButton" style="-fx-background-color: #681111; -fx-text-fill: white; -fx-background-radius: 10;" text="Remove" />
                    <Button fx:id="refreshButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
