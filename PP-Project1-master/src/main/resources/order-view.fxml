<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #681111);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.OrderController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-background-radius: 14; -fx-padding: 15;">
                <children>
                    <Label style="-fx-font-weight: bold;" text="Orders" textFill="WHITE">
                        <font><Font size="20" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Link customers to comics; track status and quantity" textFill="WHITE" />
                </children>
            </HBox>

            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="16" />
                    <ColumnConstraints percentWidth="22" />
                    <ColumnConstraints percentWidth="18" />
                    <ColumnConstraints percentWidth="18" />
                    <ColumnConstraints percentWidth="14" />
                    <ColumnConstraints percentWidth="12" />
                </columnConstraints>
                <children>
                    <Label text="Order ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="orderIdField" editable="false" promptText="new" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="Order date" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="orderDateField" promptText="YYYY-MM-DD" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <ComboBox fx:id="statusCombo" editable="false" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Label text="Customer ID" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    <TextField fx:id="customerIdField" promptText="e.g. 3" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <Label text="Comic ID" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                    <TextField fx:id="comicIdField" promptText="e.g. 5" GridPane.columnIndex="4" GridPane.rowIndex="1" />

                    <Label text="Quantity" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                    <TextField fx:id="quantityField" promptText="1" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                </children>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 12;">
                <children>
                    <TextField fx:id="searchField" promptText="Search by ID, date, customer, comic, status…" style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-border-color: #832216; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="searchButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="Search" />
                    <Button fx:id="clearButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Clear" />
                </children>
            </HBox>

            <TableView fx:id="orderTable" style="-fx-background-radius: 12; -fx-border-color: #832216; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="orderIdColumn" prefWidth="80" text="Order ID" />
                    <TableColumn fx:id="orderDateColumn" prefWidth="110" text="Date" />
                    <TableColumn fx:id="customerIdColumn" prefWidth="100" text="Customer" />
                    <TableColumn fx:id="comicIdColumn" prefWidth="90" text="Comic" />
                    <TableColumn fx:id="quantityColumn" prefWidth="70" text="Qty" />
                    <TableColumn fx:id="statusColumn" prefWidth="140" text="Status" />
                </columns>
            </TableView>

            <HBox spacing="15">
                <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10;">
                    <children>
                        <Label text="Orders in table:" />
                        <Label fx:id="totalOrdersLabel" style="-fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10">
                    <Button fx:id="addButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="New order" />
                    <Button fx:id="updateButton" style="-fx-background-color: #832216; -fx-text-fill: white; -fx-background-radius: 10;" text="Save changes" />
                    <Button fx:id="deleteButton" style="-fx-background-color: #681111; -fx-text-fill: white; -fx-background-radius: 10;" text="Remove" />
                    <Button fx:id="refreshButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
