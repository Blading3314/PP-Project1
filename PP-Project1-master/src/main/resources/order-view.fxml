<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #681111);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.OrderController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-background-radius: 14; -fx-padding: 15;">

                <children>
                    <Label style="-fx-font-weight: bold;" text="Orders Panel" textFill="WHITE">
                        <font><Font size="20" /></font>
                    </Label>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="Create and manage customer orders" textFill="WHITE" />
                </children>
            </HBox>

            <!-- FORM -->
            <GridPane hgap="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 15;" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="34" />
                </columnConstraints>

                <children>
                    <Label text="Customer ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="customerIdField" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <Label text="Comic ID" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="comicIdField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Quantity" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="quantityField" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- SEARCH -->
            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 12;">

                <children>
                    <TextField fx:id="searchField" promptText="Search orders..." style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-border-color: #832216; -fx-border-radius: 10;" HBox.hgrow="ALWAYS" />

                    <Button fx:id="searchButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="Search" />

                    <Button fx:id="clearButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Clear" />
                </children>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="orderTable" style="-fx-background-radius: 12; -fx-border-color: #832216; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="orderIdColumn" prefWidth="90" text="Order ID" />
                    <TableColumn fx:id="customerIdColumn" prefWidth="120" text="Customer ID" />
                    <TableColumn fx:id="comicIdColumn" prefWidth="120" text="Comic ID" />
                    <TableColumn fx:id="orderDateColumn" prefWidth="80" text="orderDate" />
                    <TableColumn fx:id="statusColumn" prefWidth="120" text="Status" />
                </columns>
            </TableView>

            <!-- FOOTER -->
            <HBox spacing="15">

                <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10;">

                    <children>
                        <Label text="Total Orders:" />
                        <Label fx:id="totalOrdersLabel" style="-fx-font-weight: bold;" text="0" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="10">

                    <Button fx:id="addButton" style="-fx-background-color: linear-gradient(to right, #000000, #681111); -fx-text-fill: white; -fx-background-radius: 10;" text="Add Order" />

                    <Button fx:id="updateButton" style="-fx-background-color: #832216; -fx-text-fill: white; -fx-background-radius: 10;" text="Update" />

                    <Button fx:id="deleteButton" style="-fx-background-color: #681111; -fx-text-fill: white; -fx-background-radius: 10;" text="Delete" />

                    <Button fx:id="refreshButton" style="-fx-background-color: #fff7ed; -fx-border-color: #832216; -fx-border-radius: 10;" text="Refresh" />
                </HBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
